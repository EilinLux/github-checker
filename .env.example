# GitHub App Configuration
# ============================================
# Your GitHub App ID - get this from https://github.com/settings/apps
GITHUB_APP_ID=your_app_id_here

# Path to your GitHub App private key (.pem file)
# Download this from your GitHub App settings
GITHUB_PRIVATE_KEY_PATH=./config.pem

# Installation ID of the GitHub App on your organization
# Find this in the app's installation URL
GITHUB_INSTALLATION_ID=your_installation_id_here

# (Optional) Specify a single organization to analyze
# If left blank, all organizations where the app is installed will be analyzed
# GITHUB_ORGANIZATION_NAME=YourOrgName

# Script Configuration
# ============================================
# Enable debug mode for detailed logging (True/False)
DEBUG_MODE=False

# Directory where reports will be saved
OUTPUT_DIR=output

# Parallel Processing
# ============================================
# Number of parallel workers for analyzing teams and repositories
# Increase for faster processing, but be mindful of GitHub API rate limits
MAX_WORKERS=10

# Repository Creator Configuration
# ============================================
# Target organization for creating new repositories
REPO_CREATOR_ORG_NAME=YourOrgName

# Repository configuration for repo_creator
REPO_CREATOR_NAME=new-repository
REPO_CREATOR_DESCRIPTION=Repository created by automation
REPO_CREATOR_PRIVATE=true

# Confluence Integration (Optional)
# ============================================
# Uncomment and fill these if you want to export to Confluence
# CONFLUENCE_URL=https://your-domain.atlassian.net/
# CONFLUENCE_USERNAME=your-email@example.com
# CONFLUENCE_TOKEN=your_confluence_api_token
# CONFLUENCE_SPACE=YOUR_CONFLUENCE_SPACE_KEY
